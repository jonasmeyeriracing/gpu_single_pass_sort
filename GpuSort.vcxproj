<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6F1C7E2A-3B4D-4E5F-9A8B-1C2D3E4F5A6B}</ProjectGuid>
    <RootNamespace>GpuSort</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- $(IntDir): the generated BuildInfo.h (target GenerateBuildInfo below). -->
      <AdditionalIncludeDirectories>$(IntDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>d3d12.lib;dxgi.lib;dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Message>Copying dxcompiler.dll / dxil.dll next to the executable</Message>
      <Command>copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxcompiler.dll" "$(OutDir)dxcompiler.dll" &gt; nul || exit 1
if exist "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" (copy /Y "$(WindowsSdkDir)bin\$(TargetPlatformVersion)\x64\dxil.dll" "$(OutDir)dxil.dll" &gt; nul) else (copy /Y "$(WindowsSdkDir)Redist\D3D\x64\dxil.dll" "$(OutDir)dxil.dll" &gt; nul)
if errorlevel 1 exit 1</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <!-- Static CRT: the Release exe runs without the VC++ redistributable (tools/package.ps1). -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="src\Algorithms.cpp" />
    <ClCompile Include="src\Benchmark.cpp" />
    <ClCompile Include="src\Common.cpp" />
    <ClCompile Include="src\CsvOutput.cpp" />
    <ClCompile Include="src\Device.cpp" />
    <ClCompile Include="src\main.cpp" />
    <ClCompile Include="src\Options.cpp" />
    <ClCompile Include="src\ProgressWindow.cpp" />
    <ClCompile Include="src\Results.cpp" />
    <ClCompile Include="src\ShaderCompiler.cpp" />
    <ClCompile Include="src\Verify.cpp" />
    <ClCompile Include="src\WaveProbe.cpp" />
    <ClCompile Include="src\Workloads.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\Algorithms.h" />
    <ClInclude Include="src\Benchmark.h" />
    <ClInclude Include="src\Common.h" />
    <ClInclude Include="src\CsvOutput.h" />
    <ClInclude Include="src\Device.h" />
    <ClInclude Include="src\Options.h" />
    <ClInclude Include="src\ProgressWindow.h" />
    <ClInclude Include="src\Results.h" />
    <ClInclude Include="src\ShaderCompiler.h" />
    <ClInclude Include="src\Verify.h" />
    <ClInclude Include="src\WaveProbe.h" />
    <ClInclude Include="src\Workloads.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="shaders\algorithms.txt" />
    <None Include="shaders\common.hlsli" />
    <None Include="shaders\pass0_bitonic.hlsl" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- $(IntDir)BuildInfo.h: the git commit the exe is built from (results CSV column package_commit),
       "<short sha>" or "<short sha>-dirty" (uncommitted changes to tracked files under src, shaders,
       _test, tools or the project file), "unknown" without git. Runs on every build; the file is only
       rewritten when its content changes, so an unchanged commit does not recompile anything. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="ClCompile">
    <Exec Command="git rev-parse --short HEAD 2&gt;nul" WorkingDirectory="$(ProjectDir)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GpuSortGitSha" />
      <Output TaskParameter="ExitCode" PropertyName="GpuSortGitShaExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no -- src shaders _test tools GpuSort.vcxproj 2&gt;nul"
          WorkingDirectory="$(ProjectDir)" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(GpuSortGitShaExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GpuSortGitDirty" />
    </Exec>
    <PropertyGroup>
      <GpuSortCommit>unknown</GpuSortCommit>
      <GpuSortCommit Condition="'$(GpuSortGitShaExit)' == '0' And '$(GpuSortGitSha)' != ''">$(GpuSortGitSha.Trim())</GpuSortCommit>
      <GpuSortCommit Condition="'$(GpuSortGitShaExit)' == '0' And '$(GpuSortGitSha)' != '' And '$(GpuSortGitDirty)' != ''">$(GpuSortGitSha.Trim())-dirty</GpuSortCommit>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(IntDir)BuildInfo.h" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by GpuSort.vcxproj (target GenerateBuildInfo). Do not edit.;#pragma once;#define GPUSORT_PACKAGE_COMMIT &quot;$(GpuSortCommit)&quot;" />
  </Target>
</Project>
